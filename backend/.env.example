# Puerto del servidor backend
PORT=4000

# Origen permitido para CORS (URL del frontend). Varios: separados por coma.
# En Vercel también se permiten automáticamente VERCEL_URL y la URL de producción.
CORS_ORIGIN=http://localhost:5173

# Conexion a PostgreSQL (Neon)
# Pegá la connection string del dashboard de Neon (Connection string → URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Configuracion SMTP para enviar la notificacion por email
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp

# Remitente y destinatario de las notificaciones de contacto
MAIL_FROM="AuraDev <no-reply@auradev.com>"
MAIL_TO=hola@auradev.com
