# Puerto del servidor backend
PORT=4000

# Origen permitido para CORS (URL del frontend). Varios: separados por coma.
# En Vercel también se permiten automáticamente VERCEL_URL y la URL de producción.
CORS_ORIGIN=http://localhost:5173

# Conexion a PostgreSQL (Neon)
# Pegá la connection string del dashboard de Neon (Connection string → URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Configuracion SMTP para enviar la notificacion por email
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp

# Remitente y destinatario de las notificaciones de contacto
MAIL_FROM="AuraDev <no-reply@auradev.com>"
MAIL_TO=hola@auradev.com

# --- MEJORAS SENIOR ---
# Webhook para notificaciones en tiempo real (Slack/Discord)
WEBHOOK_URL=https://hooks.slack.com/services/tu_webhook_aqui

# Habilitar auto-respuesta de agradecimiento al cliente (true/false)
ENABLE_AUTO_REPLY=true

# Notificaciones por WhatsApp (Vía CallMeBot)
# Obtén tu API KEY enviando "I allow callmebot to send me messages" a +34 644 14 44 27
WHATSAPP_PHONE=54911XXXXXXXX
WHATSAPP_API_KEY=tu_api_key_aqui

# --- Telegram (recomendado: Bot API oficial, gratis, sin Telegram Business) ---
# 1. Abrí https://web.telegram.org
# 2. Buscá @BotFather → /newbot → copiá el token
# 3. Escribile /start a tu bot
# 4. Abrí https://api.telegram.org/bot<TOKEN>/getUpdates y copiá chat.id
TELEGRAM_BOT_TOKEN=tu_token_de_botfather
TELEGRAM_CHAT_ID=tu_chat_id

# Fallback CallMeBot Telegram (opcional si no usás Bot API)
# En web.telegram.org buscá @CallMeBot_txtbot → /start → pegá la API key
TELEGRAM_API_KEY=tu_api_key_aqui
