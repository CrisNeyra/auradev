{
  "name": "auradev-backend",
  "version": "1.0.0",
  "description": "API del estudio AuraDev: formulario de contacto con PostgreSQL y notificacion por email.",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "tsx": "^4.23.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.2",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
