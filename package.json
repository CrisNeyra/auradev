{
  "name": "auradev",
  "version": "1.0.0",
  "private": true,
  "description": "AuraDev - Estudio de Desarrollo Digital. Monorepo con frontend (React + Vite) y backend (Express + PostgreSQL).",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c yellow,red \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:migrate": "npm --prefix backend run db:migrate",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test"
  },
  "dependencies": {
    "nodemailer": "^6.9.16",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
